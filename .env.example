# FinMind API token (register free at https://finmindtrade.com)
# Copy this file to .env and fill in your token.
FINMIND_TOKEN=

# FinLab API token (register free at https://ai.finlab.tw or https://finlab.finance)
# Used by src/finlab_strategy.py to reproduce the AI-agent-guide strategies.
FINLAB_API_TOKEN=

# 強勢股回調買法（docs/pullback_strategy.md）：monitor.py 的盤中觸發警報會依
# 帳戶規模 × 0.5% 風險算出建議股數。留空 = 警報不附股數。只在本機使用，不要放進 GitHub secrets。
PULLBACK_ACCOUNT_SIZE=
# 回調策略盤中輪詢預設關閉（回測未通過）；設 1 才讓 monitor.py 載入 meta.pullback_watchlist
PULLBACK_MONITOR=
